# Copy this file to .env and fill in your Supabase project's values
# (Supabase → Project Settings → API). Leave them blank to run in demo mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The public address of the browser version (GitHub Pages), used by team QR codes.
# Example: https://yourname.github.io/approach
EXPO_PUBLIC_APP_URL=
# The App Store app id (numbers only), once the iPhone app is published. Leave blank until then.
EXPO_PUBLIC_APP_STORE_ID=
