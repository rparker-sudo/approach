# Copy this file to .env and fill in your Supabase project's values
# (Supabase → Project Settings → API). Leave them blank to run in demo mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The app's public address (team QR codes, join links): https://app.approachstrength.com
EXPO_PUBLIC_APP_URL=https://app.approachstrength.com
# The website with the Privacy Notice, Terms and parent consent form: https://approachstrength.com
EXPO_PUBLIC_SITE_URL=https://approachstrength.com
# The App Store app id (numbers only), once the iPhone app is published. Leave blank until then.
EXPO_PUBLIC_APP_STORE_ID=
