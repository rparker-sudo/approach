{
  "expo": {
    "name": "Approach",
    "slug": "approach",
    "version": "2.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.approachvolleyball.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Approach"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Approach",
      "shortName": "Approach",
      "themeColor": "#0B0B0C",
      "backgroundColor": "#0B0B0C",
      "description": "Build it under the bar. Use it above the net."
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false,
            "default": false
          },
          "sitemap": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0C"
        }
      ],
      "expo-font"
    ],
    "scheme": "approach",
    "backgroundColor": "#0B0B0C",
    "platforms": [
      "ios",
      "web"
    ]
  }
}
